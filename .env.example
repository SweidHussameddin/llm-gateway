# Copied to .env (git-ignored). Spring imports it on startup.
# Cloud provider used by the "fast" and "smart" aliases. Free models work with any key.
OPENROUTER_API_KEY=
# Only needed if you enable the native Anthropic route in application.yml.
ANTHROPIC_API_KEY=
# Keys that clients send as "Authorization: Bearer <key>". Budgets are in application.yml.
GATEWAY_KEY_DEMO=demo-key
GATEWAY_KEY_TRIAL=trial-key
